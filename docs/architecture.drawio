<mxfile host="app.diagrams.net">
  <diagram id="ringgit-coach-architecture" name="How it works">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;How StudyAbroad Ringgit Coach works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#5B6B80&quot;&gt;The finance engine calculates every number. The AI coach only explains them.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=22;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="800" height="60" as="geometry" />
        </mxCell>

        <!-- 1. User -->
        <mxCell id="student" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;laptop or phone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F5F3;strokeColor=#0F766E;strokeWidth=2;fontSize=16;fontColor=#0F172A;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="450" y="85" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 2. Website container with its five sections -->
        <mxCell id="website" value="&lt;b&gt;Website&lt;/b&gt; (React) · English / Bahasa Melayu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=15;fontColor=#0F172A;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="185" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sec1" value="My plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;fontSize=13;fontColor=#0F172A;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="170" y="235" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="What if?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;fontSize=13;fontColor=#0F172A;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="325" y="235" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="Ask coach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;fontSize=13;fontColor=#0F172A;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="480" y="235" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sec4" value="Learn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;fontSize=13;fontColor=#0F172A;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="635" y="235" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sec5" value="Quiz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E1;fontSize=13;fontColor=#0F172A;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="790" y="235" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- 3. Backend -->
        <mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt; (FastAPI)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;checks every input, sends each request to the right place&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=15;fontColor=#0F172A;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="335" width="400" height="65" as="geometry" />
        </mxCell>

        <!-- 4. Engine and coach -->
        <mxCell id="engine" value="&lt;b&gt;Finance Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;PPP · IRP · Fisher Effect · IFE&lt;br&gt;calculates every number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0F766E;strokeWidth=2;fontSize=17;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="coach" value="&lt;b&gt;AI Coach&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;answers questions in plain words&lt;br&gt;explains, never calculates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6E4;strokeColor=#F59E0B;strokeWidth=2;fontSize=17;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="450" width="330" height="100" as="geometry" />
        </mxCell>

        <!-- 5. Outside service and checks -->
        <mxCell id="tests" value="&lt;b&gt;Automated tests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;check every number against our hand calculations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=15;fontColor=#0F172A;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="600" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Google Gemini&lt;/b&gt; (gemini-3.6-flash)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;turns the engine's numbers into an explanation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=15;fontColor=#0F172A;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="600" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" value="1. uses" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=12;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="student" target="website">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="2. sends the inputs" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=12;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="website" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="3. calculate" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#0F766E;strokeWidth=2;fontSize=12;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.9091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="4. chat question" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#8A5A00;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.0909;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="coach">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="5. what-if? the coach&lt;br&gt;asks the engine first" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0F766E;strokeWidth=2;dashed=1;fontSize=12;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="coach" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="6. numbers in, explanation out" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=12;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coach" target="gemini">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="verify" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tests" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;font color=&quot;#0F766E&quot;&gt;&lt;b&gt;Teal&lt;/b&gt;&lt;/font&gt; = does the maths     &lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;Amber&lt;/b&gt;&lt;/font&gt; = explains     &lt;b&gt;Dashed&lt;/b&gt; = outside service or check     ·     Illustrative data - not current market rates" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5B6B80;" vertex="1" parent="1">
          <mxGeometry x="150" y="690" width="800" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
