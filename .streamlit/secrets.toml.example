# Copy this file to .streamlit/secrets.toml and fill in your own key.
# Never commit secrets.toml (it is in .gitignore).
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.8-flash"

# Optional backup (full-stack backend): used only when every Gemini model fails.
