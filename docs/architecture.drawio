<mxfile host="app.diagrams.net">
  <diagram id="ringgit-coach-architecture" name="How it works">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;How StudyAbroad Ringgit Coach works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6B80&quot;&gt;The finance engine calculates every number. The AI coach only explains them.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="60" as="geometry" />
        </mxCell>

        <!-- Top row: the main flow -->
        <mxCell id="student" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;on a laptop or phone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F5F3;strokeColor=#0F766E;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="website" value="&lt;b&gt;Website&lt;/b&gt; (React)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;English / Bahasa Melayu&lt;br&gt;answers, charts, chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt; (FastAPI)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;checks inputs,&lt;br&gt;routes each request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;Finance Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PPP · IRP · Fisher · IFE&lt;br&gt;calculates every number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0F766E;strokeWidth=2;fontSize=14;fontColor=#FFFFFF;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="130" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Bottom row: AI and checks -->
        <mxCell id="gemini" value="&lt;b&gt;Google Gemini&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gemini-3.6-flash&lt;br&gt;writes the explanation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="coach" value="&lt;b&gt;AI Coach&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sends Gemini the engine's numbers;&lt;br&gt;explains, never calculates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF6E4;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="360" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;Automated tests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;check every number against&lt;br&gt;our hand calculations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=14;fontColor=#0F172A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="360" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Arrows: main flow (two-way = request and reply) -->
        <mxCell id="e1" value="1. plan or question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=11;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="student" target="website">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="2. send inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#5B6B80;strokeWidth=1.5;fontSize=11;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="website" target="backend">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="3. calculate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#0F766E;strokeWidth=2;fontSize=11;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="engine">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Arrows: chat path -->
        <mxCell id="e4" value="4. chat question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="coach">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. what-if? ask the engine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#0F766E;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="coach" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. numbers in,&lt;br&gt;explanation out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coach" target="gemini">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#5B6B80;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tests" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Footer / legend -->
        <mxCell id="legend" value="&lt;font color=&quot;#0F766E&quot;&gt;&lt;b&gt;Teal&lt;/b&gt;&lt;/font&gt; = does the maths    &lt;font color=&quot;#F59E0B&quot;&gt;&lt;b&gt;Amber&lt;/b&gt;&lt;/font&gt; = explains    &lt;font color=&quot;#5B6B80&quot;&gt;&lt;b&gt;Dashed&lt;/b&gt;&lt;/font&gt; = outside service or check    ·    Illustrative data - not current market rates" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6B80;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1010" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
